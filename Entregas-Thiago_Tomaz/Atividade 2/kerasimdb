          ]
        }
      ],
      "source": [
        "# Visualiza uma resenha de treino e seu respectivo rótulo\n",
        "print(\"Rótulo:\", nomes_classes[y_treino[0]])\n",
        "print(\"Texto:\", decodifica_review(x_treino[0])[:300], \"...\")"
