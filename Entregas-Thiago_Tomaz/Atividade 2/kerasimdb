        "# Função de higienização, tokenização e inferência\n",
        "def classificar_review(texto):\n",
        "    texto_limpo = re.sub(r'[^a-zA-Z\\s]', '', texto.lower())\n",
        "    palavras = texto_limpo.split()\n",
