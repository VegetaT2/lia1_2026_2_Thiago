    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "imdb_build_model_12"
      },
      "outputs": [],
      "source": [
        "# Arquitetura do Modelo -> Feature Learning em Texto\n",
        "modelo_imdb = models.Sequential()\n",
        "modelo_imdb.add(layers.Input(shape=(max_len,)))\n",
        "\n",
        "# Camada de Embedding (converte índices de palavras em vetores densos)\n",
        "modelo_imdb.add(layers.Embedding(input_dim=max_features, output_dim=64))\n",
        "\n",
        "# Camadas de convolução temporal e pooling\n",
        "modelo_imdb.add(layers.Conv1D(64, 5, activation='relu'))\n",
        "modelo_imdb.add(layers.MaxPooling1D(pool_size=4))\n",
        "\n",
        "modelo_imdb.add(layers.Conv1D(64, 5, activation='relu'))\n",
        "modelo_imdb.add(layers.GlobalMaxPooling1D())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "imdb_dense_layers_13"
      },
      "outputs": [],
      "source": [
        "# Adicionar camadas densas de classificação\n",
        "modelo_imdb.add(layers.Dense(64, activation='relu'))\n",
        "modelo_imdb.add(layers.Dropout(0.5))\n",
        "modelo_imdb.add(layers.Dense(1, activation='sigmoid'))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "imdb_compile_14"
      },
      "outputs": [],
      "source": [
        "# Compilação do modelo\n",
        "modelo_imdb.compile(\n",
        "    optimizer='adam',\n",
        "    loss='binary_crossentropy',\n",
        "    metrics=['accuracy']\n",
        ")"
      ]
    },
